# Required
MONGO_URI=mongodb://localhost:27017
REDIS_URI=redis://localhost:6379/0

# Clerk auth. Leave empty/unset to DISABLE auth (all requests act as user "local").
CLERK_JWT_ISSUER=
CLERK_JWKS_TTL_SECONDS=3600

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# Optional
ENVIRONMENT=development   # "development" exposes /docs, /redoc, /openapi.json
PORT=8000
